{
  "name": "dealping-backend",
  "version": "1.0.0",
  "description": "DealPing backend - Express + PostgreSQL (Prisma) price tracker for Shopee",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "npx nodemon src/server.js",
    "start": "npx prisma db push && node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "axios": "^1.7.7",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.7",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^5.20.0"
  }
}
