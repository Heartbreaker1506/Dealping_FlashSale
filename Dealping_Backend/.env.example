PORT=3000

# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://user:password@host:5432/dealping_db"

# JWT Secret for backend sessions
JWT_SECRET=super_secret_key_change_me_in_production

# Firebase Admin SDK credentials
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Lazada Credentials
LAZADA_APP_KEY=your_key
LAZADA_APP_SECRET=your_secret
LAZADA_USER_TOKEN=your_token

# AccessTrade Credentials
ACCESSTRADE_API_KEY=your_key
ACCESSTRADE_PUB_ID=your_pub_id
ACCESSTRADE_TIKTOK_CAMPAIGN_ID=your_campaign_id

# Shopee Credentials
SHOPEE_AFFILIATE_ID=your_id

# Web Push VAPID Keys
VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"
VAPID_SUBJECT="mailto:support@dealping.com"

# Email Feedback Configuration
FEEDBACK_TO_EMAIL="dealpingflashsale@gmail.com"
SMTP_USER="dealpingflashsale@gmail.com"
# Mật khẩu ứng dụng 16 ký tự từ Google Account:
# Vào https://myaccount.google.com/apppasswords -> Tạo App password cho "DealPing"
SMTP_PASS="your_16_char_google_app_password"
